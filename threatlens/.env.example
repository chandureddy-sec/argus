# Copy to .env and fill in. .env is git-ignored; never commit real values.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

TL_ENV=dev
TL_LOG_LEVEL=INFO
TL_LOG_JSON=true

# Native (non-Docker) development points at the compose ports on localhost:
# TL_DATABASE_URL=postgresql+asyncpg://threatlens:<POSTGRES_PASSWORD>@localhost:5432/threatlens
# TL_REDIS_URL=redis://localhost:6379/0

# Raw feed documents (gzipped, content-addressed). In Docker this is a volume.
# TL_DATA_DIR=data

# Free-tier keys. Sources whose key is missing are reported as "skipped".
# TL_ABUSECH_AUTH_KEY=   # https://auth.abuse.ch/ (ThreatFox needs it; URLhaus optional)
# TL_OTX_API_KEY=        # https://otx.alienvault.com/ (account settings)

# Allowlist: how many Tranco top domains never become active indicators.
# TL_TRANCO_TOP=10000
