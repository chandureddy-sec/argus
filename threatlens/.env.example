# Copy to .env and fill in. .env is git-ignored; never commit real values.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

TL_ENV=dev
TL_LOG_LEVEL=INFO
TL_LOG_JSON=true

# Native (non-Docker) development points at the compose ports. Use 127.0.0.1, not
# "localhost": on Windows "localhost" resolves to ::1 first, the ports are published
# on IPv4 only, and the detour makes short connect timeouts fail.
# TL_DATABASE_URL=postgresql+asyncpg://threatlens:<POSTGRES_PASSWORD>@127.0.0.1:5432/threatlens
# TL_REDIS_URL=redis://127.0.0.1:6379/0

# Raw feed documents (gzipped, content-addressed). In Docker this is a volume.
# TL_DATA_DIR=data

# Free-tier keys. Sources whose key is missing are reported as "skipped".
# TL_ABUSECH_AUTH_KEY=   # https://auth.abuse.ch/ (ThreatFox needs it; URLhaus optional)
# TL_OTX_API_KEY=        # https://otx.alienvault.com/ (account settings)

# Allowlist: how many Tranco top domains never become active indicators.
# TL_TRANCO_TOP=10000

# Knowledge base (Phase 2).
# TL_ATTACK_DOMAINS=["enterprise-attack","mobile-attack","ics-attack"]
# TL_NVD_API_KEY=        # https://nvd.nist.gov/developers/request-an-api-key (optional; much faster)
# TL_NVD_SCOPE=relevant  # or "all" for a full NVD mirror
# TL_NVD_MAX_REQUESTS=60 # per run; without a key requests are 6.5 s apart
# TL_OSV_MAX_PER_RUN=300

# Argus UI (http://127.0.0.1:8000/app/): signs session cookies. `.\tl up` generates one.
# TL_SECRET_KEY=
# It also encrypts the API keys of feeds added in the Feed catalog (ADR 0012): changing it means
# entering those keys again.

# Enrichment (Phase 3). All optional; an enricher without its key is "skipped".
# MalwareBazaar uses TL_ABUSECH_AUTH_KEY above. RDAP, RIPEstat, crt.sh, DNS and
# GreyNoise (25 lookups/week) work without keys.
# TL_ABUSEIPDB_API_KEY=   # https://www.abuseipdb.com/account/api (1,000 checks/day)
# TL_GREYNOISE_API_KEY=   # https://viz.greynoise.io/account/api-key (optional)
# TL_VIRUSTOTAL_API_KEY=  # https://www.virustotal.com/gui/my-apikey (non-commercial use only)
# TL_URLSCAN_API_KEY=     # https://urlscan.io/user/profile/ (optional)
# TL_ENRICH_AUTO_PER_RUN=100   # IP indicators enriched (ASN/geo) per background run; 0 = off
# TL_SCORING_PATH=config/scoring.yaml   # scoring model v1 (ADR 0008); edits apply on the next rescore

# Performance (Phase 9, docs/PERFORMANCE.md).
# TL_API_WORKERS=2               # API processes (Docker); each serves about 100 cached lookups/s
# TL_DASHBOARD_CACHE_S=30         # dashboard aggregates are reused this long per TLP clearance; 0 = off

# Products and AI (Phase 8, ADR 0021/0022).
# TL_PRODUCTS_MAX_TLP=TLP:GREEN   # most sensitive content a daily/weekly/exec product may include
# TL_LOOKALIKE_CT=true            # lookalike monitoring queries crt.sh by brand keyword (needs org.domains)
# The report assistant sends report text to the Claude API. Off unless enabled.
# TL_AI_ENABLED=false
# TL_AI_API_KEY=                  # https://console.anthropic.com/ (or set ANTHROPIC_API_KEY)
# TL_AI_MODEL=claude-opus-5-5
# TL_AI_MAX_TLP=TLP:GREEN         # reports marked above this are never sent; TLP:RED never is
